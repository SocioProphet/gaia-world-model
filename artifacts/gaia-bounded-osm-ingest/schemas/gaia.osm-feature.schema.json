{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/gaia/schemas/gaia.osm-feature.schema.json",
  "title": "GAIA Normalized OSM Feature v1",
  "description": "Normalized GAIA OSM feature binding output from the bounded ingest pipeline. Emitted per OSM element (node, way, relation).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_version",
    "binding_id",
    "source",
    "osm_ref",
    "gaia_ref",
    "spatial",
    "attribution",
    "provenance",
    "classification"
  ],
  "properties": {
    "binding_version": {"type": "string", "const": "v1"},
    "binding_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "const": "OpenStreetMap"},
    "osm_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["osm_type", "osm_id"],
      "properties": {
        "osm_type": {"type": "string", "enum": ["node", "way", "relation"]},
        "osm_id": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "timestamp": {"type": "string"},
        "changeset": {"type": "string"},
        "tags": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "gaia_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "entity_type"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "entity_type": {
          "type": "string",
          "enum": ["RoadSegment", "RailSegment", "WaterwaySegment", "SpatialFeature"]
        },
        "authority": {"type": "string"}
      }
    },
    "spatial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry_ref", "h3_cells", "bbox", "crs"],
      "properties": {
        "geometry_ref": {"type": "string", "minLength": 1},
        "geometry_type": {
          "type": "string",
          "enum": ["Point", "LineString", "Polygon", "MultiLineString", "MultiPolygon", "Other"]
        },
        "h3_cells": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "bbox": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 4,
          "maxItems": 4
        },
        "crs": {"type": "string"}
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_name", "license_ref", "attribution_text"],
      "properties": {
        "source_name": {"type": "string"},
        "license_ref": {"type": "string", "const": "ODbL-1.0"},
        "attribution_text": {"type": "string"},
        "source_url": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "fixture_digest"],
      "properties": {
        "source_refs": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "extract_ref": {"type": "string"},
        "runtime_refs": {"type": "array", "items": {"type": "string"}},
        "content_hash": {"type": "string"},
        "created_at": {"type": "string"},
        "fixture_digest": {"type": "string", "minLength": 1}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data_class": {
          "type": "string",
          "enum": ["public", "internal", "restricted", "sensitive"]
        },
        "handling_tags": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
