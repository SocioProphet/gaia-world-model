{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/gaia/schemas/geospatial/osm_route_graph_manifest.v1.schema.json",
  "title": "OSMRouteGraphManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "graph_id",
    "source",
    "safety_status",
    "nodes",
    "edges",
    "attribution",
    "provenance",
    "classification"
  ],
  "properties": {
    "manifest_version": {"type": "string", "const": "v1"},
    "graph_id": {"type": "string"},
    "source": {"type": "string", "const": "OpenStreetMap"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "safety_status": {"type": "string", "enum": ["advisory", "validated", "restricted", "not-for-navigation", "unknown"]},
    "modes": {"type": "array", "items": {"type": "string"}},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "geometry_ref"],
        "properties": {
          "node_id": {"type": "string"},
          "geometry_ref": {"type": "string"},
          "h3_cell": {"type": "string"},
          "role": {"type": "string"}
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edge_id", "from_node", "to_node", "feature_ref", "geometry_ref"],
        "properties": {
          "edge_id": {"type": "string"},
          "from_node": {"type": "string"},
          "to_node": {"type": "string"},
          "feature_ref": {"type": "string"},
          "geometry_ref": {"type": "string"},
          "modes": {"type": "array", "items": {"type": "string"}},
          "access_tags": {"type": "object", "additionalProperties": {"type": "string"}},
          "safety_status": {"type": "string", "enum": ["advisory", "validated", "restricted", "not-for-navigation", "unknown"]}
        }
      }
    },
    "spatial": {
      "type": "object",
      "properties": {
        "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
        "h3_cells": {"type": "array", "items": {"type": "string"}},
        "crs": {"type": "string"}
      }
    },
    "attribution": {
      "type": "object",
      "required": ["attribution_text", "license_refs"],
      "properties": {
        "attribution_text": {"type": "string"},
        "license_refs": {"type": "array", "items": {"type": "string"}},
        "source_urls": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source_refs"],
      "properties": {
        "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "runtime_refs": {"type": "array", "items": {"type": "string"}},
        "created_at": {"type": "string", "format": "date-time"},
        "content_hash": {"type": "string"}
      }
    },
    "classification": {"type": "object", "properties": {"data_class": {"type": "string", "enum": ["public", "internal", "restricted", "sensitive"]}, "handling_tags": {"type": "array", "items": {"type": "string"}}}}
  }
}
