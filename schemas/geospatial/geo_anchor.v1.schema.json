{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/gaia/schemas/geospatial/geo_anchor.v1.schema.json",
  "title": "GeoAnchor v1",
  "description": "Spatial-temporal anchor for a GAIA observation or world-claim. A claim is not admissible without at least one anchor binding it to a verifiable geometry, cell, tile region, or time window.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anchor_version",
    "anchor_id",
    "anchor_type",
    "crs",
    "temporal"
  ],
  "properties": {
    "anchor_version": {"type": "string", "const": "v1"},
    "anchor_id": {"type": "string", "description": "Stable anchor identifier, namespaced by observation or claim."},
    "anchor_type": {
      "type": "string",
      "enum": ["point", "linestring", "polygon", "bbox", "h3_cell", "tile_region", "document_span", "time_window"],
      "description": "Primary anchor geometry class."
    },
    "geometry": {
      "type": "object",
      "description": "GeoJSON geometry for point/linestring/polygon anchors.",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"type": "string", "enum": ["Point", "LineString", "Polygon", "MultiLineString", "MultiPolygon"]},
        "coordinates": {}
      }
    },
    "bbox": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 4,
      "maxItems": 4,
      "description": "[min_lon, min_lat, max_lon, max_lat] in the declared CRS."
    },
    "h3_cells": {
      "type": "array",
      "items": {"type": "string"},
      "description": "H3 cell identifiers covering this anchor."
    },
    "tile_region": {
      "type": "object",
      "description": "Raster or vector tile region reference.",
      "properties": {
        "tile_scheme": {"type": "string", "enum": ["xyz", "tms", "quad", "stac_tile", "raster_tile"]},
        "tile_ref": {"type": "string"},
        "zoom_level": {"type": "integer", "minimum": 0}
      }
    },
    "document_span": {
      "type": "object",
      "description": "Source document span anchor (e.g. field report region reference).",
      "properties": {
        "document_ref": {"type": "string"},
        "span_start": {"type": "integer", "minimum": 0},
        "span_end": {"type": "integer", "minimum": 0}
      }
    },
    "crs": {
      "type": "string",
      "description": "Coordinate reference system (e.g. EPSG:4326)."
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at"],
      "description": "Temporal bounds for this anchor.",
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_to": {"type": "string", "format": "date-time"},
        "time_basis": {
          "type": "string",
          "enum": ["sensor_capture", "field_report", "document_timestamp", "reanalysis", "model_output", "unknown"]
        }
      }
    },
    "source_ref": {
      "type": "string",
      "description": "Reference to the source observation or document that produced this anchor."
    },
    "provenance": {
      "type": "object",
      "properties": {
        "derived_from": {"type": "array", "items": {"type": "string"}},
        "runtime_ref": {"type": "string"},
        "content_hash": {"type": "string"}
      }
    }
  }
}
