{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/gaia/schemas/control-tower/control_tower_decision_card.v1.schema.json",
  "title": "ControlTowerDecisionCard v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_version",
    "card_id",
    "created_at",
    "situation_type",
    "summary",
    "scope",
    "evidence_refs",
    "recommendations",
    "policy",
    "provenance"
  ],
  "properties": {
    "card_version": {"type": "string", "const": "v1"},
    "card_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "situation_type": {"type": "string", "enum": ["asset_health", "inventory_imbalance", "route_disruption", "sustainability", "field_trust", "mesh_health", "mixed"]},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_refs": {"type": "array", "items": {"type": "string"}},
        "inventory_node_refs": {"type": "array", "items": {"type": "string"}},
        "route_refs": {"type": "array", "items": {"type": "string"}},
        "mesh_node_refs": {"type": "array", "items": {"type": "string"}},
        "spatial_refs": {"type": "array", "items": {"type": "object", "required": ["scheme", "value"], "properties": {"scheme": {"type": "string"}, "value": {"type": "string"}, "role": {"type": "string"}}}},
        "temporal_scope": {"type": "object", "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}, "scenario_id": {"type": "string"}}}
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "model_refs": {"type": "array", "items": {"type": "string"}},
    "runtime_refs": {"type": "array", "items": {"type": "string"}},
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "confidence_class": {"type": "string", "enum": ["low", "moderate", "high", "unknown"]},
        "uncertainty_note": {"type": "string"},
        "confidence_drivers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recommendation_id", "action_type", "priority", "description"],
        "properties": {
          "recommendation_id": {"type": "string"},
          "action_type": {"type": "string", "enum": ["observe", "inspect", "maintain", "repair", "replace", "reroute", "reserve", "allocate", "source_alternative", "restrict", "close", "notify", "defer", "approve_work_order", "none"]},
          "priority": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "description": {"type": "string"},
          "target_refs": {"type": "array", "items": {"type": "string"}},
          "requires_human_approval": {"type": "boolean"},
          "approval_ref": {"type": "string"},
          "policy_constraints": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["action_status"],
      "properties": {
        "action_status": {"type": "string", "enum": ["advisory_only", "approval_required", "approved", "rejected", "blocked", "executed"]},
        "policy_refs": {"type": "array", "items": {"type": "string"}},
        "handling_tags": {"type": "array", "items": {"type": "string"}},
        "safety_notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source_refs"],
      "properties": {
        "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "runtime_refs": {"type": "array", "items": {"type": "string"}},
        "model_refs": {"type": "array", "items": {"type": "string"}},
        "generated_by": {"type": "string"},
        "content_hash": {"type": "string"}
      }
    }
  }
}
